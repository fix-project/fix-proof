opam-version: "2.0"
synopsis: "Fix coupon proofs in Rocq using WasmCert-Coq"
maintainer: "Fix project"
authors: "Fix project"
homepage: "https://github.com/fix-project/fix-proof"
bug-reports: "https://github.com/fix-project/fix-proof/issues"
dev-repo: "git+https://github.com/fix-project/fix-proof.git"
description: "Rocq proofs of Fix evaluation and coupon construction using WasmCert-Coq."
depends: [
  "coq" {= "9.1.1"}
  "coq-wasm" {= "2.2.1"}
  "conf-python-3" {build}
]
depexts: [
  ["wabt"] {os-family = "debian" | os-family = "fedora" | os-family = "arch" | os = "macos"}
]
build: [
  [make "check-generated"] {with-test}
  [make "rocq"]
]
run-test: [make "check"]
